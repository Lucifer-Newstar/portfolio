{
    "RoleName": "lambda-dynamodb-role",
    "PolicyName": "lambda-ssm-github-token-read",
    "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
            {
                "Sid": "ReadPortfolioGitHubTokenParameter",
                "Effect": "Allow",
                "Action": [
                    "ssm:GetParameter"
                ],
                "Resource": "arn:aws:ssm:us-east-1:969849535462:parameter/portfolio/github/token"
            }
        ]
    }
}
